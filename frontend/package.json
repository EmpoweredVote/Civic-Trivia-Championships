{
  "name": "civic-trivia-frontend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/write-build-info.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "serve -s dist -l 10000",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@empoweredvote/analytics": "^0.2.0",
    "@empoweredvote/ev-ui": "^0.11.0",
    "@floating-ui/react": "^0.27.20",
    "@headlessui/react": "^2.2.10",
    "@react-spring/web": "^10.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "canvas-confetti": "^1.9.4",
    "focus-trap-react": "^12.0.3",
    "framer-motion": "^13.1.1",
    "posthog-js": "^1.422.2",
    "react": "^19.2.8",
    "react-countdown-circle-timer": "^3.2.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "serve": "^14.2.4",
    "web-vitals": "^6.2.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@posthog/rollup-plugin": "^1.5.1",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "playwright": "^1.62.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.3",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  }
}
