{
  "name": "civic-trivia-frontend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/write-build-info.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "serve -s dist -l 10000",
    "smoke": "node scripts/smoke.mjs",
    "smoke:game": "node scripts/game-smoke.mjs",
    "check:tableau": "node scripts/tableau-build-check.mjs",
    "test:dom": "vitest run --project dom",
    "test:node": "vitest run --project node"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@empoweredvote/analytics": "^0.3.0",
    "@empoweredvote/ev-ui": "^0.14.0",
    "@floating-ui/react": "^0.27.20",
    "@headlessui/react": "^2.2.10",
    "@react-spring/web": "^10.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "canvas-confetti": "^1.9.4",
    "focus-trap-react": "^12.0.3",
    "framer-motion": "^14.3.0",
    "posthog-js": "^1.438.7",
    "react": "^19.3.0",
    "react-countdown-circle-timer": "^3.2.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "serve": "^14.2.4",
    "web-vitals": "^6.2.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@posthog/rollup-plugin": "^1.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
