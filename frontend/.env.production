# CTC's own API (admin, game, profile, XP). The standalone civic-trivia-backend
# is RETIRED — its routes were merged into ev-accounts under the /ctc/* alias, so
# the base is the accounts host PLUS the /ctc prefix (do not drop it — the bare
# host 404s every trivia route). NOTE: Render's build env sets VITE_API_URL and
# OVERRIDES this file at build time; keep both at the /ctc value so they agree.
VITE_API_URL=https://api.empowered.vote/ctc
# Empowered Accounts API — shared identity platform
# Update this URL when the accounts API is deployed to a different host
VITE_EMPOWERED_ACCOUNTS_URL=https://api.empowered.vote
# Supabase — required for token refresh (exchangeRefreshToken)
VITE_SUPABASE_URL=https://kxsdzaojfaibhuzmclfq.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_3EmJxAlEamebHURr3bspGQ_CzQEugF4
# Empowered Accounts web UI — user-facing site for account management
VITE_EMPOWERED_ACCOUNTS_WEB_URL=https://accounts.empowered.vote
