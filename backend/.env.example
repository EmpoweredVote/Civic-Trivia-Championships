PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Redis (for game session storage)
REDIS_URL=redis://localhost:6379

# Supabase (shared platform project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# NOTE: This standalone backend (civic-trivia-backend) is RETIRED — its HTTP
# API was merged into ev-accounts (api.empowered.vote). These auth vars apply
# only if this server is run again; live auth config lives in ev-accounts.
#
# WorkOS AuthKit — second accepted token issuer (ev-accounts decision 0002).
# Leave WORKOS_CLIENT_ID unset for Supabase-only auth. When it is set, the
# backend ALSO accepts WorkOS-issued JWTs — the accounts hub issues these for
# WorkOS sessions, and the admin panel depends on them being accepted.
# The value must match the WorkOS *environment* the accounts app issues from
# (staging vs production). A missing or mismatched value silently rejects every
# WorkOS token, which breaks admin access and all authenticated calls for
# WorkOS-session users. WORKOS_ISSUER / WORKOS_JWKS_URL are optional overrides;
# by default they are derived from WORKOS_CLIENT_ID.
WORKOS_CLIENT_ID=client_your-workos-client-id
# WORKOS_ISSUER=https://api.workos.com/user_management/client_your-workos-client-id
# WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/client_your-workos-client-id

# Empowered Accounts platform (required for gem awards and tier checks)
EMPOWERED_ACCOUNTS_URL=https://your-empowered-accounts-api.com

# Empowered Accounts — XP award service (required for Phase 53 XP integration)
# Base URL for the Empowered Accounts API (used for XP awards, may differ from EMPOWERED_ACCOUNTS_URL)
EMPOWERED_ACCOUNTS_API_URL=https://your-empowered-accounts-api.com
# Service-to-service auth key — never expose to browser clients
TRIVIA_SERVICE_KEY=your-trivia-service-key-here
# Service-to-service auth key for gem awards — scope: ["yellow"]
TRIVIA_GEMS_KEY=your-trivia-gems-key-here

# OpenAI API (for semantic dedup - text-embedding-3-small)
OPENAI_API_KEY=sk-your-openai-api-key-here
