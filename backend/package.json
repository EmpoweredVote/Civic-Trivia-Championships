{
  "name": "civic-trivia-backend",
  "version": "1.0.0",
  "description": "Backend API for Civic Trivia Championship",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && cp -r src/data dist/ && mkdir -p dist/db/seed && cp src/db/seed/sources.json dist/db/seed/",
    "start": "node --dns-result-order=ipv4first dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit push",
    "db:seed": "tsx src/db/seed/seed.ts",
    "db:seed:community": "tsx src/db/seed/seed-community.ts",
    "audit-questions": "tsx src/scripts/audit-questions.ts",
    "audit-address-phone": "tsx src/scripts/audit-address-phone.ts",
    "archive-violations": "tsx src/scripts/archive-violations.ts",
    "verify:production": "tsx src/scripts/verify-production.ts",
    "scan-duplicates": "tsx src/scripts/scan-duplicates.ts",
    "generate-election-questions": "tsx src/scripts/generate-election-questions.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "cheerio": "^1.2.0",
    "compromise": "^14.16.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "express-validator": "^7.3.2",
    "jose": "^6.2.10",
    "link-check": "^5.6.0",
    "node-cron": "^4.6.0",
    "openai": "^6.22.0",
    "p-limit": "^7.3.1",
    "pg": "^8.23.0",
    "redis": "^4.6.12",
    "rss-parser": "^3.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.9",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3"
  }
}
