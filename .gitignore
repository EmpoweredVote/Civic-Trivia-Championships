# Dependencies
node_modules/

# Build output
dist/

# Uploads
uploads/

# Environment files
# Covers bare `.env` plus every variant, including suffixed ones
# like .env.bak and .env.save that exact-match rules miss.
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*

# Editor directories
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Package lock files (keep package-lock.json, ignore others)
yarn.lock
pnpm-lock.yaml

# Docker volumes
redis-data

# Accidental double-extension files
*.js.js

# Generated content artifacts
backend/generated-content-*.json
backend/generated-questions-*.json
backend/generation-report-*.json
backend/generation-archives/

# Embedding cache (Phase 31 dedup tooling)
backend/.embedding-cache/
.embedding-cache/

# Claude Code internals
.claude/worktrees/

# Dedup reports (generated, review locally)
.planning/dedup-reports/*.json
.planning/dedup-reports/*.md

# Editor/tooling backups. A `.env.bak` holding live credentials sat
# untracked in ev-accounts on 2026-07-26 and a single `git add -A`
# would have published it.
*.bak
*.backup
*.orig
*~

# Playwright MCP page captures. 556 of these were committed to
# ev-accounts and held live credentials.
.playwright-mcp/
